rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection rules
    match /users/{userId} {
      // Users can read their own profile and public profiles
      allow read: if request.auth != null && 
                     (request.auth.uid == userId || 
                      resource.data.visibility == 'public' ||
                      request.auth.token.admin == true);
      
      // Users can update their own profile
      allow write: if request.auth != null && 
                     request.auth.uid == userId &&
                     validateUserUpdate();
      
      // Only authenticated users can create new user documents
      allow create: if request.auth != null && 
                       request.auth.uid == userId &&
                       validateUserCreation();
    }
    
    // Leaderboard access - read-only for authenticated users
    match /users/{userId}/stats {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Friends collection rules
    match /friends/{friendId} {
      allow read, write: if request.auth != null && 
                          (request.auth.uid == friendId.split('_')[0] || 
                           request.auth.uid == friendId.split('_')[1]);
    }
    
    // Friend requests collection rules
    match /friend_requests/{requestId} {
      allow read: if request.auth != null && 
                    (request.auth.uid == resource.data.fromUserId ||
                     request.auth.uid == resource.data.toUserId);
      
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.fromUserId &&
                      validateFriendRequest();
      
      allow update: if request.auth != null && 
                      request.auth.uid == resource.data.toUserId &&
                      validateFriendRequestUpdate();
      
      allow delete: if request.auth != null && 
                      (request.auth.uid == resource.data.fromUserId ||
                       request.auth.uid == resource.data.toUserId);
    }
    
    // Challenges collection rules
    match /challenges/{challengeId} {
      allow read: if request.auth != null && 
                    (request.auth.uid == resource.data.challengerId ||
                     request.auth.uid == resource.data.challengedId ||
                     resource.data.status == 'completed');
      
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.challengerId &&
                      validateChallenge();
      
      allow update: if request.auth != null && 
                      (request.auth.uid == resource.data.challengerId ||
                       request.auth.uid == resource.data.challengedId) &&
                      validateChallengeUpdate();
      
      allow delete: if request.auth != null && 
                      (request.auth.uid == resource.data.challengerId ||
                       request.auth.uid == resource.data.challengedId ||
                       request.auth.token.admin == true);
    }
    
    // Social activities collection rules
    match /social_activities/{activityId} {
      allow read: if request.auth != null && 
                    (resource.data.isVisible == true ||
                     request.auth.uid == resource.data.userId ||
                     request.auth.token.admin == true);
      
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.userId &&
                      validateSocialActivity();
      
      allow update: if request.auth != null && 
                      request.auth.uid == resource.data.userId &&
                      validateSocialActivityUpdate();
      
      allow delete: if request.auth != null && 
                      (request.auth.uid == resource.data.userId ||
                       request.auth.token.admin == true);
    }
    
    // Questions collection rules (read-only for authenticated users)
    match /questions/{questionId} {
      allow read: if request.auth != null && resource.data.isActive == true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Helper functions for validation
    function validateUserCreation() {
      return request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt']) &&
             request.resource.data.uid == request.auth.uid &&
             request.resource.data.uid is string &&
             request.resource.data.email is string &&
             request.resource.data.displayName is string &&
             request.resource.data.createdAt is timestamp &&
             request.resource.data.friends is list &&
             request.resource.data.stats is map;
    }
    
    function validateUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAll(['lastLoginAt', 'isOnline', 'stats', 'friends']) ||
             request.resource.data.diff(resource.data).affectedKeys().size() == 0;
    }
    
    function validateFriendRequest() {
      return request.resource.data.keys().hasAll(['id', 'fromUserId', 'toUserId', 'status', 'createdAt']) &&
             request.resource.data.fromUserId == request.auth.uid &&
             request.resource.data.fromUserId != request.resource.data.toUserId &&
             request.resource.data.status in ['pending', 'accepted', 'declined'] &&
             request.resource.data.createdAt is timestamp;
    }
    
    function validateFriendRequestUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAll(['status', 'respondedAt']) &&
             request.resource.data.status in ['accepted', 'declined'] &&
             request.resource.data.respondedAt is timestamp;
    }
    
    function validateChallenge() {
      return request.resource.data.keys().hasAll(['id', 'challengerId', 'challengedId', 'category', 'difficulty', 'status', 'questions', 'createdAt']) &&
             request.resource.data.challengerId == request.auth.uid &&
             request.resource.data.challengerId != request.resource.data.challengedId &&
             request.resource.data.status in ['pending', 'accepted', 'active', 'completed', 'expired'] &&
             request.resource.data.questions is list &&
             request.resource.data.questions.size() > 0 &&
             request.resource.data.createdAt is timestamp;
    }
    
    function validateChallengeUpdate() {
      let allowedKeys = ['status', 'acceptedAt', 'completedAt', 'challengerScore', 'challengedScore', 'winner', 'challengerResult', 'challengedResult'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }
    
    function validateSocialActivity() {
      return request.resource.data.keys().hasAll(['id', 'userId', 'userName', 'type', 'timestamp', 'isVisible']) &&
             request.resource.data.userId == request.auth.uid &&
             request.resource.data.type in ['quizCompleted', 'challengeWon', 'challengeLost', 'friendAdded', 'achievementUnlocked'] &&
             request.resource.data.timestamp is timestamp &&
             request.resource.data.isVisible is bool;
    }
    
    function validateSocialActivityUpdate() {
      let allowedKeys = ['reactions', 'isVisible'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }
  }
}
